    "options": {
      "type": "object",
      "default": {
        "isLabel": true,
        "isRequired": false,
        "isIcon": true
      }
    },
    "password": {
      "type": "object",
      "default": {
        "options": {
          "isWeek": true,
          "isStrengthMeter": false,
